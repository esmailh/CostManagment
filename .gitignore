node_modules/
dist/
dist-single/
dev-dist/
*.local
.DS_Store

# TypeScript build info
*.tsbuildinfo

# Hand-copied deliverables — regenerated by the build scripts, not source.
# See the "build gotchas" notes: the APK copy and expense-tracker.html both go
# stale silently, so they are deliberately kept out of version control.
apk/*.apk
expense-tracker.html

# Gradle/CLI logs
android/*.log

# PRIVATE: raw dumps of the real phone database — expense records, loans,
# IndexedDB exports and screenshots of live data. Never commit these.
android/phone-backups/
